+name: VitaCheat NG verified build
+
+on:
+  workflow_dispatch:
+  push:
+    branches:
+      - 'codex/vitacheat-ng-*'
+    paths:
+      - 'vitacheat-ng/**'
+      - '.ci/vitacheat/**'
+      - '.github/workflows/vitacheat-build.yml'
+  pull_request:
+    paths:
+      - 'vitacheat-ng/**'
+      - '.ci/vitacheat/**'
+      - '.github/workflows/vitacheat-build.yml'
+
+permissions:
+  contents: read
+
+concurrency:
+  group: vitacheat-ng-${{ github.ref }}
+  cancel-in-progress: true
+
+defaults:
+  run:
+    shell: bash
+    working-directory: vitacheat-ng
+
+jobs:
+  host:
+    name: Host ${{ matrix.mode }}
+    runs-on: ubuntu-24.04
+    timeout-minutes: 20
+    strategy:
+      fail-fast: false
+      matrix:
+        mode: [normal, sanitizer, release]
+    steps:
+      - name: Checkout source
+        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
+        with:
+          persist-credentials: false
+
+      - name: Reconstruct and verify corrected source
+        working-directory: .
+        run: python3 .ci/vitacheat/unpack.py
+
+      - name: Host regression gate
+        if: matrix.mode == 'normal'
+        run: |
+          set -euo pipefail
+          python3 tools/test_host.py 2>&1 | tee host-normal.log
+
+      - name: ASan and UBSan regression gate
+        if: matrix.mode == 'sanitizer'
