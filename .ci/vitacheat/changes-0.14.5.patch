+typedef struct {
+    uint32_t base;
+    uint8_t data[0x4000];
+    uint32_t changing_root, next_root;
+    unsigned root_reads, writes;
+} fake_mem;
+
+static int rd(void *ctx, uint32_t address, void *out, size_t size) {
+    fake_mem *m = ctx;
+    if (address < m->base || (uint64_t)address + size > (uint64_t)m->base + sizeof(m->data)) return -1;
+    memcpy(out, m->data + (address - m->base), size);
+    if (address == m->changing_root && size == 4u) {
+        m->root_reads++;
+        memcpy(m->data + (address - m->base), &m->next_root, 4u);
+    }
+    return 0;
+}
+
+static int wr(void *ctx, uint32_t address, const void *value, size_t size) {
+    fake_mem *m = ctx;
+    if (address < m->base || (uint64_t)address + size > (uint64_t)m->base + sizeof(m->data)) return -1;
+    memcpy(m->data + (address - m->base), value, size);
+    m->writes++;
+    return 0;
+}
+
+static void pointer_widths(void) {
+    fake_mem m = {0};
+    m.base = 0x81000000u;
+    vcng_memory memory = {rd, wr, &m};
+    vcng_pointer_path path = {0};
+    path.root = m.base + 0x100u;
+    path.levels = 1u;
+    path.offsets[0] = 0x20u;
+    uint32_t first_object = m.base + 0x200u;
+    uint32_t second_object = m.base + 0x300u;
+    m.changing_root = path.root;
+    m.next_root = second_object - path.offsets[0];
+    uint32_t initial_root = first_object - path.offsets[0];
+    memcpy(m.data + 0x100u, &initial_root, 4u);
+
+    /* This root changes immediately after each read. A split 64-bit lowering
+     * would place the two halves in different objects; generation must stop. */
+    const vcng_type wide_types[] = {VCNG_U64, VCNG_I64, VCNG_F64};
+    uint64_t wide = UINT64_C(0x1122334455667788);
+    vcng_cheat c = {0};
+    for (size_t i = 0; i < sizeof(wide_types) / sizeof(wide_types[0]); ++i) {
+        assert(vcng_codegen_pointer(&c, "Wide pointer", &path, wide_types[i], &wide, NULL) == -2);
+        assert(c.lines == NULL && c.count == 0u && c.capacity == 0u && !c.auto_enable);
+    }
+    assert(m.root_reads == 0u && m.writes == 0u);
+
+    const vcng_type narrow_types[] = {VCNG_U8, VCNG_U16, VCNG_U32};
+    uint32_t value = 0x55667788u;
+    for (size_t i = 0; i < sizeof(narrow_types) / sizeof(narrow_types[0]); ++i) {
+        size_t width = vcng_type_width(narrow_types[i]);
+        memset(m.data + 0x200u, 0xa5, 8u);
+        memset(m.data + 0x300u, 0x5a, 8u);
+        memcpy(m.data + 0x100u, &initial_root, 4u);
+        m.root_reads = m.writes = 0u;
+        assert(vcng_codegen_pointer(&c, "Narrow pointer", &path, narrow_types[i], &value, NULL) == 0);
+        assert(!c.auto_enable);
