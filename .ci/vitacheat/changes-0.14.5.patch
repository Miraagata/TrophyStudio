+    vcng_vita_runtime_init(&rt, &memory);
+    assert(vcng_vita_execute_cheat(&rt, &c, NULL) == 0);
+    assert(memcmp(m.data + 0x200u, &wide, 8u) == 0);
+    vcng_codegen_cheat_free(&c);
